{
    integer func fact(n : integer) =
        { var r : integer;
          var i : integer;
          r := 1
          i := 1
          loop
              if i > n then exit end if
              r := r * i
              i := i + 1
          end loop
          ;
          r
        };

    var k : integer;

    k := 5;
    put "5! = ", fact(k), skip;
    put "7! = ", fact(7), skip
}
