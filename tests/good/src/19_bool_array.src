{
    var flags[3] : boolean;
    var ints[3] : integer;
    var i : integer;
    i := 0;
    loop
        if i >= 3 then exit end if;
        flags[i] := i = 1;
        i := i + 1
    end loop;
    i := 0;
    loop
        if i >= 3 then exit end if;
        put "flags[", i, "] = ", flags[i], skip;
        i := i + 1
    end loop;
    get ints[0];
    get ints[1];
    put "ints[0] + ints[1] = ", ints[0] + ints[1], skip
}
