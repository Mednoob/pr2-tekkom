{
    integer func gcd(a : integer, b : integer) =
        { var t : integer;
          loop
              if b = 0 then exit end if;
              t := b;
              b := a - (a / b) * b;
              a := t
          end loop
          ;
          a
        };

    put "gcd(48,36) = ", gcd(48, 36), skip;
    put "gcd(17,5)  = ", gcd(17, 5), skip
}
